{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading | default: 'What people are saying'
  assign subheading = section.settings.subheading
  assign columns = section.settings.columns | default: 3
-%}

<section class="th-reviews" id="throttle-reviews-{{ section.id }}" style="--th-reviews-cols: {{ columns }};">
  <div class="th-reviews__inner">
    <div class="th-reviews__head">
      {%- if eyebrow != blank -%}
        <span class="th-reviews__eyebrow">{{ eyebrow }}</span>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="th-reviews__heading th-display">{{ heading }}</h2>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="th-reviews__subheading">{{ subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="th-reviews__grid">
        {%- for block in section.blocks -%}
          {%- assign rating = block.settings.rating | default: 5 -%}
          <figure class="th-review" {{ block.shopify_attributes }}>
            {%- if section.settings.show_stars -%}
              <div class="th-review__stars" aria-label="{{ rating }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <span class="th-review__star{% if i > rating %} is-empty{% endif %}">&#9733;</span>
                {%- endfor -%}
              </div>
            {%- endif -%}
            {%- if block.settings.quote != blank -%}
              <blockquote class="th-review__quote">{{ block.settings.quote }}</blockquote>
            {%- endif -%}
            <figcaption class="th-review__author">
              {%- if block.settings.avatar != blank -%}
                <img class="th-review__avatar" src="{{ block.settings.avatar }}" alt="{{ block.settings.name }}" loading="lazy" width="44" height="44">
              {%- else -%}
                <span class="th-review__avatar th-review__avatar--initial">{{ block.settings.name | slice: 0 | upcase }}</span>
              {%- endif -%}
              <span class="th-review__meta">
                <span class="th-review__name">
                  {{ block.settings.name | default: 'Happy Customer' }}
                  {%- if block.settings.verified -%}
                    <span class="th-review__verified" title="Verified buyer">&#10003;</span>
                  {%- endif -%}
                </span>
                {%- if block.settings.detail != blank -%}
                  <span class="th-review__detail">{{ block.settings.detail }}</span>
                {%- endif -%}
              </span>
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .th-reviews { padding: 80px 24px; background: var(--th-cream-2); }
  .th-reviews__inner { max-width: 1480px; margin: 0 auto; }
  .th-reviews__head { text-align: center; margin-bottom: 48px; }
  .th-reviews__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--th-accent);
    margin-bottom: 14px;
  }
  .th-reviews__heading { font-size: clamp(1.8rem, 4vw, 2.8rem); margin: 0; }
  .th-reviews__subheading {
    color: var(--th-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 560px;
    margin: 16px auto 0;
  }
  .th-reviews__grid {
    display: grid;
    grid-template-columns: repeat(var(--th-reviews-cols, 3), minmax(0, 1fr));
    gap: 24px;
  }
  @media (max-width: 1024px) { .th-reviews__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .th-reviews__grid { grid-template-columns: 1fr; } }
  .th-review {
    background: #fff;
    border: 1px solid #ececec;
    border-radius: var(--th-card-radius);
    padding: 32px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .th-review:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 44px rgba(20,17,15,0.08);
  }
  .th-review__stars { display: flex; gap: 3px; color: var(--th-accent); font-size: 1.05rem; line-height: 1; }
  .th-review__star.is-empty { color: #d9d2c9; }
  .th-review__quote {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--th-ink);
    font-weight: 500;
    flex: 1;
  }
  .th-review__author { display: flex; align-items: center; gap: 12px; }
  .th-review__avatar {
    width: 44px; height: 44px;
    border-radius: 999px;
    object-fit: cover;
    flex: none;
  }
  .th-review__avatar--initial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--th-ink);
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
  }
  .th-review__meta { display: flex; flex-direction: column; gap: 2px; }
  .th-review__name { font-weight: 700; font-size: 0.95rem; color: var(--th-ink); display: inline-flex; align-items: center; gap: 6px; }
  .th-review__verified {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px; height: 16px;
    background: var(--th-accent);
    color: #fff;
    border-radius: 999px;
    font-size: 0.65rem;
  }
  .th-review__detail { color: var(--th-muted); font-size: 0.85rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Throttle Reviews",
  "tag": "section",
  "class": "throttle-reviews-wrapper",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people are saying" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Thousands of shoppers, one catalog they trust." },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_stars", "label": "Show star ratings", "default": true }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Fast shipping and the quality is genuinely better than I expected. Already ordered again." },
        { "type": "text", "id": "name", "label": "Name", "default": "Alex Rivera" },
        { "type": "text", "id": "detail", "label": "Detail (location, product)", "default": "Verified buyer" },
        { "type": "url", "id": "avatar", "label": "Avatar image URL" },
        { "type": "checkbox", "id": "verified", "label": "Show verified badge", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Throttle Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
