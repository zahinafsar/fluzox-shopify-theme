{%- liquid
  assign heading = section.settings.heading | default: 'Out of stock — page-wise.'
  assign body = section.settings.body | default: 'Skip the detour and head to the catalog.'
  assign cta_label = section.settings.cta_label | default: 'Shop the Catalog'
  assign cta_link = section.settings.cta_link | default: '/collections/all'
-%}
<section class="th-stub">
  <div class="th-stub__inner">
    <h1 class="th-display th-stub__heading">{{ heading }}</h1>
    <p class="th-stub__body">{{ body }}</p>
    <a class="th-pill th-pill--dark" href="{{ cta_link }}">{{ cta_label }}</a>
  </div>
</section>

{% stylesheet %}
  .th-stub {
    min-height: 70svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
    background: var(--th-cream);
  }
  .th-stub__inner { max-width: 720px; text-align: center; }
  .th-stub__heading { font-size: clamp(2rem, 5vw, 3.5rem); margin: 0 0 16px; color: var(--th-ink); }
  .th-stub__body { color: var(--th-muted); font-size: 1.05rem; margin: 0 0 32px; line-height: 1.6; }
{% endstylesheet %}

{% schema %}
{
  "name": "Throttle Stub",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [ { "name": "Throttle Stub" } ]
}
{% endschema %}
