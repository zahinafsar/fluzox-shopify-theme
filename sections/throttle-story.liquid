{%- liquid
  assign default_bg = 'https://images.pexels.com/photos/30109293/pexels-photo-30109293.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=1100&w=1800'
  assign bg_url = section.settings.bg_url | default: default_bg
  assign heading = section.settings.heading | default: 'Hand-picked across every category'
  assign body = section.settings.body
  assign cta_label = section.settings.cta_label | default: 'How We Curate'
  assign cta_link = section.settings.cta_link | default: '/'
-%}

<section class="th-story" id="throttle-story-{{ section.id }}">
  <div class="th-story__card">
    <div class="th-story__bg" style="background-image: url('{{ bg_url }}');"></div>
    <div class="th-story__overlay"></div>
    <div class="th-story__content">
      <h2 class="th-story__heading">{{ heading }}</h2>
      {%- if body != blank -%}
        <p class="th-story__body">{{ body }}</p>
      {%- else -%}
        <p class="th-story__body">Clothing, home, tech, kitchen, gifts. One catalog, one editor's pick per slot — so you don't have to scroll ten tabs to find the right one.</p>
      {%- endif -%}
      {%- if cta_label != blank -%}
        <a href="{{ cta_link }}" class="th-pill">{{ cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Throttle Story",
  "tag": "section",
  "class": "throttle-story-wrapper",
  "settings": [
    { "type": "url",  "id": "bg_url",   "label": "Background image URL" },
    { "type": "text", "id": "heading",  "label": "Heading",  "default": "Hand-picked across every category" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label","label": "CTA label","default": "How We Curate" },
    { "type": "url",  "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [
    { "name": "Throttle Story" }
  ]
}
{% endschema %}
