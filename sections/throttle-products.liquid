{%- liquid
  assign collection_handle = section.settings.collection
  assign limit = section.settings.limit | default: 8
  if template.name == 'collection' and collection != blank
    assign coll = collection
  else
    assign coll = collections[collection_handle]
  endif
  if coll == blank or coll.products.size == 0
    assign coll = collections.all
  endif

  assign fallbacks = 'https://images.pexels.com/photos/16428734/pexels-photo-16428734.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940|https://images.pexels.com/photos/6312194/pexels-photo-6312194.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940|https://images.pexels.com/photos/15487609/pexels-photo-15487609.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940|https://images.pexels.com/photos/6956493/pexels-photo-6956493.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940|https://images.pexels.com/photos/7193625/pexels-photo-7193625.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940|https://images.pexels.com/photos/18257675/pexels-photo-18257675.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940|https://images.pexels.com/photos/9584702/pexels-photo-9584702.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940|https://images.pexels.com/photos/8502484/pexels-photo-8502484.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940'
  assign fallback_arr = fallbacks | split: '|'

  assign placeholder_titles = 'Wool Overshirt|Ceramic Mug|Wireless Headphones|Soy Candle|Court Sneaker|Cotton Tee|Field Watch|Leather Tote'
  assign placeholder_arr = placeholder_titles | split: '|'
-%}

<section class="th-products" id="throttle-products-{{ section.id }}">
  <div class="th-products__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="th-products__heading th-display">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="th-products__grid" data-product-grid>
      {%- if coll.products.size > 0 -%}
        {%- for product in coll.products limit: limit -%}
          {%- assign idx = forloop.index0 | modulo: 8 -%}
          {%- assign fallback_img = fallback_arr[idx] -%}
          {%- assign on_sale = false -%}
          {%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}
          {%- assign hover_img = product.images[1] -%}
          <a href="{{ product.url }}" class="th-product-card{% unless product.available %} is-soldout{% endunless %}">
            <div class="th-product-card__media">
              {%- if on_sale -%}<span class="th-product-card__badge th-product-card__badge--sale">Sale</span>{%- endif -%}
              {%- unless product.available -%}<span class="th-product-card__badge th-product-card__badge--soldout">Sold Out</span>{%- endunless -%}
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 800 | image_tag: alt: product.title, loading: 'lazy', class: 'th-product-card__img' }}
              {%- else -%}
                <img src="{{ fallback_img }}" alt="{{ product.title }}" loading="lazy" class="th-product-card__img">
              {%- endif -%}
              {%- if hover_img -%}
                {{ hover_img | image_url: width: 800 | image_tag: alt: '', loading: 'lazy', class: 'th-product-card__img th-product-card__img--hover' }}
              {%- endif -%}
              <span class="th-product-card__cta" aria-hidden="true">View</span>
            </div>
            <div class="th-product-card__body">
              <div class="th-product-card__title">{{ product.title }}</div>
              <div class="th-product-card__price">
                {%- if product.price_varies -%}
                  <span class="th-product-card__price-from">From</span> {{ product.price_min | money }}
                {%- elsif on_sale -%}
                  <span class="th-product-card__price-sale">{{ product.price | money }}</span>
                  <span class="th-product-card__price-compare">{{ product.compare_at_price | money }}</span>
                {%- else -%}
                  {{ product.price | money }}
                {%- endif -%}
              </div>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (0..7) -%}
          {%- assign fallback_img = fallback_arr[i] -%}
          {%- assign p_title = placeholder_arr[i] -%}
          <a href="/collections/all" class="th-product-card">
            <div class="th-product-card__media">
              <img src="{{ fallback_img }}" alt="{{ p_title }}" loading="lazy" class="th-product-card__img">
            </div>
            <div class="th-product-card__title">{{ p_title }}</div>
            <div class="th-product-card__price">$15.00 – $109.00</div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .th-products { padding: 64px 24px; background: var(--th-cream); }
  .th-products__inner { max-width: 1480px; margin: 0 auto; }
  .th-products__heading { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 0 0 32px; }
  .th-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  @media (max-width: 1024px) { .th-products__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .th-products__grid { grid-template-columns: 1fr; } }
  .th-product-card {
    text-decoration: none;
    color: var(--th-ink);
    display: block;
    position: relative;
  }
  .th-product-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    overflow: hidden;
    background: #f4f4f4;
    margin-bottom: 14px;
    box-shadow: 0 1px 0 rgba(0,0,0,0.02);
    transition: transform 0.4s cubic-bezier(0.2,0.8,0.2,1), box-shadow 0.3s ease;
  }
  .th-product-card:hover .th-product-card__media {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(20,17,15,0.12);
  }
  .th-product-card__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2,0.8,0.2,1), opacity 0.35s ease;
  }
  .th-product-card:hover .th-product-card__img { transform: scale(1.06); }
  .th-product-card__img--hover { opacity: 0; }
  .th-product-card:hover .th-product-card__img--hover { opacity: 1; }
  .th-product-card:hover .th-product-card__img:not(.th-product-card__img--hover) { opacity: 0; }

  .th-product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .th-product-card__badge--sale { background: var(--th-accent); color: #fff; }
  .th-product-card__badge--soldout {
    background: rgba(20,17,15,0.85);
    color: #fff;
    left: auto; right: 12px;
  }

  .th-product-card__cta {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 2;
    padding: 8px 16px;
    background: #fff;
    color: var(--th-ink);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    box-shadow: 0 6px 18px rgba(0,0,0,0.15);
  }
  .th-product-card:hover .th-product-card__cta {
    opacity: 1;
    transform: translateY(0);
  }

  .th-product-card.is-soldout .th-product-card__img { opacity: 0.55; }
  .th-product-card.is-soldout:hover .th-product-card__img { transform: none; }

  .th-product-card__body { padding: 0 2px; }
  .th-product-card__title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--th-ink);
    margin-bottom: 6px;
    line-height: 1.3;
    transition: color 0.2s ease;
  }
  .th-product-card:hover .th-product-card__title { color: var(--th-accent); }
  .th-product-card__price {
    color: var(--th-ink);
    font-size: 0.95rem;
    font-weight: 600;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .th-product-card__price-from {
    color: var(--th-muted);
    font-weight: 500;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .th-product-card__price-sale { color: var(--th-accent); }
  .th-product-card__price-compare {
    color: var(--th-muted);
    text-decoration: line-through;
    font-weight: 400;
    font-size: 0.85rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Throttle Products",
  "tag": "section",
  "class": "throttle-products-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Max products", "min": 4, "max": 16, "step": 4, "default": 8 }
  ],
  "presets": [ { "name": "Throttle Products" } ]
}
{% endschema %}
