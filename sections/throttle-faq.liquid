{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading | default: 'Frequently asked questions'
  assign subheading = section.settings.subheading
-%}

<section class="th-faq" id="throttle-faq-{{ section.id }}">
  <div class="th-faq__inner">
    <div class="th-faq__head">
      {%- if eyebrow != blank -%}
        <span class="th-faq__eyebrow">{{ eyebrow }}</span>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="th-faq__heading th-display">{{ heading }}</h2>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="th-faq__subheading">{{ subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="th-faq__list">
        {%- for block in section.blocks -%}
          <details class="th-faq__item" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
            <summary class="th-faq__q">
              <span>{{ block.settings.question | default: 'Question goes here' }}</span>
              <span class="th-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="th-faq__a">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .th-faq { padding: 80px 24px; background: var(--th-cream); }
  .th-faq__inner { max-width: 880px; margin: 0 auto; }
  .th-faq__head { text-align: center; margin-bottom: 40px; }
  .th-faq__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--th-accent);
    margin-bottom: 14px;
  }
  .th-faq__heading { font-size: clamp(1.8rem, 4vw, 2.8rem); margin: 0; }
  .th-faq__subheading {
    color: var(--th-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 560px;
    margin: 16px auto 0;
  }
  .th-faq__list { display: flex; flex-direction: column; gap: 14px; }
  .th-faq__item {
    background: #fff;
    border: 1px solid #ececec;
    border-radius: 18px;
    padding: 4px 26px;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .th-faq__item[open] {
    border-color: rgba(200,32,42,0.35);
    box-shadow: 0 10px 30px rgba(20,17,15,0.06);
  }
  .th-faq__q {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--th-ink);
  }
  .th-faq__q::-webkit-details-marker { display: none; }
  .th-faq__icon {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
  }
  .th-faq__icon::before,
  .th-faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--th-accent);
    border-radius: 2px;
    transition: transform 0.3s ease;
  }
  .th-faq__icon::before { width: 14px; height: 2px; transform: translate(-50%, -50%); }
  .th-faq__icon::after { width: 2px; height: 14px; transform: translate(-50%, -50%); }
  .th-faq__item[open] .th-faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); opacity: 0; }
  .th-faq__a {
    color: var(--th-ink-2);
    line-height: 1.7;
    padding: 0 0 24px;
    font-size: 1rem;
  }
  .th-faq__a p { margin: 0 0 12px; }
  .th-faq__a p:last-child { margin-bottom: 0; }
  .th-faq__a a { color: var(--th-accent); }
{% endstylesheet %}

{% schema %}
{
  "name": "Throttle FAQ",
  "tag": "section",
  "class": "throttle-faq-wrapper",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Support" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Everything you need to know before you order." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most orders ship within 1–2 business days and arrive in 3–5 days.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Throttle FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
